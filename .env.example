# BONNIE Configuration
# Copy this file to .env and customize for your environment.

# Required: Bearer token for API authentication
BONNIE_AUTH_TOKEN=your-secret-token-here

# HTTP listen address (default: :7777)
# BONNIE_LISTEN_ADDR=:7777

# GPU polling interval in seconds (default: 10)
# BONNIE_POLL_INTERVAL=10

# Docker daemon socket (default: unix:///var/run/docker.sock)
# BONNIE_DOCKER_HOST=unix:///var/run/docker.sock

# On-disk cache for staged model artifacts (default: /var/lib/bonnie/models)
# BONNIE_MODEL_STORAGE_DIR=/var/lib/bonnie/models

# HuggingFace token for fetching gated models (optional).
# Falls back to HF_TOKEN if unset.
# BONNIE_HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Logging level: debug, info, warn, error (default: info)
# LOG_LEVEL=info

# Logging format: text, json (default: text)
# LOG_FORMAT=text

# OpenBao secrets provider (optional, falls back to env vars)
# OPENBAO_ADDR=https://openbao.example.com:8200
# OPENBAO_TOKEN=your-openbao-token
